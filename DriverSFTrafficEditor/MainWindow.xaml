<Window x:Class="DriverSFTrafficEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Driver SF Traffic Editor" Height="835" Width="1250"
        MinWidth="1000" MinHeight="680" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextBrush}">
    <Window.Resources>
        <!-- Explicit templates avoid white-on-white WPF theme defaults when editing grid cells
             or opening the ComboBox popup. Theme colors come from App.xaml dictionaries. -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ButtonPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource DisabledBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource SelectedBrush}"/>
            <Setter Property="SelectionTextBrush" Value="{DynamicResource TextBrush}"/>
            <Setter Property="MinHeight" Value="32"/>
        </Style>
        <Style x:Key="GridDisplayTextStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <Style x:Key="GridEditTextStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemChrome" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource SelectedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="MaxDropDownHeight" Value="320"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropToggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Background="{TemplateBinding Background}"
                                          Foreground="{TemplateBinding Foreground}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                            <Grid>
                                                <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                                                      Margin="0,0,12,0" Stroke="{TemplateBinding Foreground}"
                                                      StrokeThickness="1.8" Data="M 0 0 L 5 5 L 10 0"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="10,3,30,3" IsHitTestVisible="False"
                                              HorizontalAlignment="Left" VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Background="{DynamicResource InputBrush}"
                                        BorderBrush="{DynamicResource InputBorderBrush}"
                                        BorderThickness="1" CornerRadius="4">
                                    <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                                  CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemChrome" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource SelectedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="RowBackground" Value="{DynamicResource GridRowBrush}"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource GridAltRowBrush}"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="RowHeight" Value="33"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectedBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                    <Setter Property="Background" Value="{DynamicResource SelectedBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource GridHeaderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel Grid.Row="0" IsItemsHost="True" Panel.ZIndex="1"/>
                            <Border Grid.Row="1" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabChrome" Background="{DynamicResource TabBrush}"
                                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,1,1,0"
                                Padding="{TemplateBinding Padding}" Margin="0,0,4,0" CornerRadius="5,5,0,0">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"
                                              VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabChrome" Property="Background" Value="{DynamicResource PanelBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="Separator">
            <Setter Property="Background" Value="{DynamicResource LineBrush}"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18,15,18,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="DRIVER SF  /  TRAFFIC EDITOR" TextTrimming="CharacterEllipsis" FontWeight="Bold" FontSize="22" Foreground="{DynamicResource TextBrush}"/>
                <TextBlock Text="Offline .fchunk editing  •  58 spooling settings  •  all 208 weight profiles" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Name="OpenButton" Content="Open .fchunk" Click="Open_Click"/>
                <Button Name="SaveButton" Content="Save patched copy…" Click="SaveAs_Click" IsEnabled="False" Style="{StaticResource AccentButtonStyle}"/>
                <Button Name="ReportButton" Content="Export change report" Click="ExportReport_Click" IsEnabled="False" Margin="0,0,8,0"/>
                <Button Name="ThemeButton" Content="Dark mode" Click="ThemeToggle_Click" Margin="0" ToolTip="Switch between light and dark color palettes"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                CornerRadius="6" Padding="12,9" Margin="0,0,0,12">
            <TextBlock Name="FileLabel" Text="No file open. Choose the original retail PC san_franciscoAI.fchunk." TextTrimming="CharacterEllipsis"/>
        </Border>

        <TabControl Grid.Row="2" Name="MainTabs">
            <TabItem Header="Spooling lists">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="315"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="TRAFFIC SETTINGS" Style="{StaticResource SectionTitle}"/>
                        <TextBox Name="SetSearchBox" Grid.Row="1" Margin="0,0,0,8" TextChanged="SetSearch_Changed" ToolTip="Search by name, hash, or record number"/>
                        <ListBox Name="SetsList" Grid.Row="2" DisplayMemberPath="DisplayName" SelectionChanged="SetsList_Changed"/>
                    </Grid>
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Name="SetTitle" Grid.Row="0" Style="{StaticResource SectionTitle}" Text="Open a resource to begin"/>
                        <TextBlock Name="SetInfo" Grid.Row="1" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,12" Text="Vehicle IDs are UInt16 little-endian values"/>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
                            <TextBlock Text="Vehicle group:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox Name="GroupPicker" Width="205" DisplayMemberPath="Display" SelectionChanged="GroupPicker_Changed"/>
                            <TextBlock Name="GroupOffset" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="{DynamicResource MutedTextBrush}"/>
                        </StackPanel>
                        <DataGrid Name="SpoolGrid" Grid.Row="3" CellEditEnding="Grid_CellEditEnding">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Slot" Binding="{Binding Slot}" IsReadOnly="True" Width="70" ElementStyle="{StaticResource GridDisplayTextStyle}"/>
                                <DataGridTextColumn Header="Vehicle ID (edit)" Binding="{Binding VehicleId, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" Width="*" ElementStyle="{StaticResource GridDisplayTextStyle}" EditingElementStyle="{StaticResource GridEditTextStyle}"/>
                                <DataGridTextColumn Header="Hex ID" Binding="{Binding IdHex}" IsReadOnly="True" Width="120" ElementStyle="{StaticResource GridDisplayTextStyle}"/>
                                <DataGridTextColumn Header="ID file offset" Binding="{Binding OffsetHex}" IsReadOnly="True" Width="150" ElementStyle="{StaticResource GridDisplayTextStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Grid.Row="4" Background="{DynamicResource PanelBrush}" CornerRadius="6" Padding="12" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="REPLACE AN ID IN THIS GROUP" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Name="OldSpoolId" Width="90" ToolTip="Existing vehicle ID in decimal"/>
                                    <TextBlock Text="  →  " VerticalAlignment="Center"/>
                                    <TextBox Name="NewSpoolId" Width="90" ToolTip="Replacement vehicle ID in decimal"/>
                                    <Button Name="ReplaceSpoolButton" Content="Replace one entry" Margin="12,0,0,0" Click="ReplaceSpool_Click"/>
                                </StackPanel>
                                <TextBlock Text="Changing the spooling list does not change weight profiles. Preserve mission-critical IDs unless you have tested their replacements." Style="{StaticResource Hint}" Margin="0,9,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Probability weights">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="420"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="ALL 208 PROBABILITY TABLES" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Grid.Row="1" Text="All 208 tables in number order. Search using any part of a table name or number. SM = Story Mission."
                                   Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <StackPanel Grid.Row="2" Margin="0,0,0,10">
                            <TextBlock Text="Search table number or name (contains)" Margin="0,0,0,4"/>
                            <DockPanel>
                                <Button Content="Clear" DockPanel.Dock="Right" Margin="8,0,0,0" Click="ClearProfileFilter_Click"/>
                                <TextBox Name="ProfileNumberSearchBox" TextChanged="ProfileFilter_Changed"
                                         ToolTip="Case-insensitive contains search: e.g. Heat, SM2, 16 or 0xA6"/>
                            </DockPanel>
                            <TextBlock Name="ProfileCountLabel" Text="Showing 0 of 208 tables" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
                        </StackPanel>
                        <ListBox Grid.Row="3" Name="ProfilesList" SelectionChanged="ProfilesList_Changed"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding DisplayName}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Grid.Row="4" Text="Names are recorded traffic-setting names, not exclusive categories. Tables with no identified name show (unnamed)."
                                   Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,9,0,0"/>
                    </Grid>
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Name="ProfileTitle" Style="{StaticResource SectionTitle}" Text="Choose a profile"/>
                        <TextBlock Grid.Row="1" Name="ProfileInfo" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <DockPanel Grid.Row="2" Margin="0,0,0,10">
                            <TextBlock Text="Filter vehicle ID:" VerticalAlignment="Center" Margin="0,0,10,0" DockPanel.Dock="Left"/>
                            <TextBox Name="WeightSearchBox" Width="170" TextChanged="WeightSearch_Changed" ToolTip="Filter by decimal or 0xHEX ID" DockPanel.Dock="Left"/>
                            <TextBlock Name="TotalLabel" TextAlignment="Right" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <DataGrid Name="WeightGrid" Grid.Row="3" CellEditEnding="Grid_CellEditEnding">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Vehicle ID" Binding="{Binding VehicleId}" IsReadOnly="True" Width="95" ElementStyle="{StaticResource GridDisplayTextStyle}"/>
                                <DataGridTextColumn Header="Hex ID" Binding="{Binding IdHex}" IsReadOnly="True" Width="100" ElementStyle="{StaticResource GridDisplayTextStyle}"/>
                                <DataGridTextColumn Header="Weight (edit)" Binding="{Binding Weight, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, StringFormat=F4}" Width="*" ElementStyle="{StaticResource GridDisplayTextStyle}" EditingElementStyle="{StaticResource GridEditTextStyle}"/>
                                <DataGridTextColumn Header="Float32 bits" Binding="{Binding FloatHex}" IsReadOnly="True" Width="125" ElementStyle="{StaticResource GridDisplayTextStyle}"/>
                                <DataGridTextColumn Header="Weight offset" Binding="{Binding OffsetHex}" IsReadOnly="True" Width="140" ElementStyle="{StaticResource GridDisplayTextStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Grid.Row="4" Background="{DynamicResource PanelBrush}" CornerRadius="6" Padding="12" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="TRANSFER WEIGHT BETWEEN TWO VEHICLES" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Name="WeightFromId" Width="90" ToolTip="Source ID (decimal)"/>
                                    <TextBlock Text="  →  " VerticalAlignment="Center"/>
                                    <TextBox Name="WeightToId" Width="90" ToolTip="Destination ID (decimal)"/>
                                    <Button Name="TransferButton" Content="Move full weight" Margin="12,0,0,0" Click="TransferWeight_Click"/>
                                </StackPanel>
                                <TextBlock Text="Adds the source's weight to the destination and zeroes the source. The total-weight metadata is recalculated when saving." Style="{StaticResource Hint}" Margin="0,9,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Find vehicle">
                <Grid Margin="18">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="FIND VEHICLE OCCURRENCES" Style="{StaticResource SectionTitle}"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,13">
                        <TextBox Name="VehicleSearchBox" Width="180" ToolTip="Decimal ID or 0x-prefixed hexadecimal"/>
                        <Button Content="Search loaded file" Click="VehicleSearch_Click" Margin="12,0,0,0"/>
                        <TextBlock Text="Searches all 58 spooling records and all 208 probability tables." Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                    <TextBox Name="VehicleResults" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="13"/>
                </Grid>
            </TabItem>

            <TabItem Header="Notes &amp; safety">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="22" MaxWidth="850" HorizontalAlignment="Left">
                        <TextBlock Text="FILE-LEVEL EDITING — NO ASI, NO DEBUGGER" FontSize="18" FontWeight="Bold" Margin="0,0,0,18"/>
                        <TextBlock TextWrapping="Wrap" LineHeight="24" FontSize="14"
                                   Text="Load the original retail PC san_franciscoAI.fchunk (4,403,200 bytes). Edit vehicle IDs and float weights in the first two tabs. Save a separate patched copy, along with its exact byte-offset change report. The app never overwrites the loaded source file."/>
                        <Separator Margin="0,18,0,18"/>
                        <TextBlock Text="Important constraints" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8"/>
                        <TextBlock TextWrapping="Wrap" LineHeight="24" FontSize="14"
                                   Text="• Vehicle groups 0–4 are fixed-size; this tool replaces IDs but never adds slots.&#10;• A positive probability weight does not automatically spool that car. Update the appropriate spooling list too.&#10;• A vehicle in a spooling list is not automatically given a nonzero probability.&#10;• Mission-important original IDs include 144, 176, 287 and 298; replacing them may break missions.&#10;• The app does not expand the game's vehicle spooling/residency limits.&#10;• All 208 probability tables are editable; unmodified entries remain byte-for-byte intact.&#10;• Profile 50 is a Chapter 1 compatibility candidate, not confirmed runtime usage.&#10;• Traffic groups and table-to-road/lane semantics are still partially unknown."/>
                        <Separator Margin="0,18,0,18"/>
                        <TextBlock Text="Confirmed retail PC format" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock FontFamily="Consolas" FontSize="13" Text="Spooling metadata:   0x280A18 / 58 records / 0x1C stride&#10;Vehicle ID pool:     0x281080 / uint16 little-endian&#10;Weight metadata:     0x2DDA80 / 0x0C stride&#10;Weight table data:   0x2DE440 / 0x5F8 stride&#10;Weight entry:        uint32 ID + float32 probability&#10;Profiles:            208 total, all editable&#10;Entries per profile: 191"/>
                    </StackPanel>
